COMPOSE_PROJECT_NAME=store-yasakovd
REGISTRY_IMAGE=store-yasakovd
RELEASE_TAG=manual
HTTP_PORT=18080
JWT_SECRET=replace-with-at-least-48-random-characters
DB_PASSWORD=replace-with-random-password
# Set the name of the existing Nginx Proxy Manager network before --proxy deployment.
NPM_NETWORK=replace-with-existing-proxy-network
